":"bP","h7":"bP","a2":"wP","b2":"wP","c2":"wP","d2":"wP","f2":"wP","g2":"wP","h2":"wP","a1":"wR","b1":"wN","c1":"wB","d1":"wQ","e1":"wK","f1":"wB","g1":"wN","h1":"wR","d5":"wP"},"turn":"Black","caption":"2 exd5: White’s e-pawn captures diagonally on d5.","from":"e4","to":"d5","marks":["e4","d5"]},{"pieces":{"a8":"bR","b8":"bN","c8":"bB","e8":"bK","f8":"bB","g8":"bN","h8":"bR","a7":"bP","b7":"bP","c7":"bP","e7":"bP","f7":"bP","g7":"bP","h7":"bP","a2":"wP","b2":"wP","c2":"wP","d2":"wP","f2":"wP","g2":"wP","h2":"wP","a1":"wR","b1":"wN","c1":"wB","d1":"wQ","e1":"wK","f1":"wB","g1":"wN","h1":"wR","d5":"bQ"},"turn":"White","caption":"…Qxd5: Black’s queen recaptures along the cleared d-file.","from":"d8","to":"d5","marks":["d8","d5"]},{"pieces":{"a8":"bR","b8":"bN","c8":"bB","e8":"bK","f8":"bB","g8":"bN","h8":"bR","a7":"bP","b7":"bP","c7":"bP","e7":"bP","f7":"bP","g7":"bP","h7":"bP","a2":"wP","b2":"wP","c2":"wP","d2":"wP","f2":"wP","g2":"wP","h2":"wP","a1":"wR","c1":"wB","d1":"wQ","e1":"wK","f1":"wB","g1":"wN","h1":"wR","d5":"bQ","c3":"wN"},"turn":"Black","caption":"3 Nc3: the knight develops and attacks the queen on d5.","from":"b1","to":"c3","marks":["b1","c3"]}]}]},"spanish-1":{"kind":"spanish","lines":[["Café worker","¿Quiere comer algo?","Would you like something to eat?"],["You","Quiero comer. Tengo hambre.","I want to eat. I’m hungry."],["You","¿Puedo pagar con tarjeta?","Can I pay by card?"]]},"spanish-2":{"kind":"spanish","lines":[["Friend","¿Qué hiciste ayer?","What did you do yesterday?"],["You","Ayer fui al mercado y compré pan.","Yesterday I went to the market and bought bread."]]},"spanish-3":{"kind":"spanish","lines":[["Friend","¿Qué hacías cuando llamó Ana?","What were you doing when Ana called?"],["You","Comía cuando Ana llamó.","I was eating when Ana called."],["You, another version","Estaba comiendo cuando Ana llamó.","I was eating when Ana called."]]},"spanish-4":{"kind":"spanish","lines":[["Friend","¿Qué hiciste el sábado? ¿Y qué vas a hacer mañana?","What did you do on Saturday? And what are you going to do tomorrow?"],["You","El sábado estaba cansado. Después fui al parque.","I was tired on Saturday. Afterward I went to the park."],["You","Mañana voy a descansar.","Tomorrow I’m going to rest."]]},"questions":{"kind":"spanish","lines":[["You","¿Puede ayudarme, por favor?","Can you help me, please?"],["Staff member","Sí. ¿Puede pagar en efectivo?","Yes. Can you pay in cash?"],["You","No puedo pagar en efectivo. ¿Puedo pagar con tarjeta?","I can’t pay in cash. Can I pay by card?"]]},"habits":{"kind":"spanish","lines":[["You","Trabajo por la mañana y estudio por la noche.","I work in the morning and study at night."],["You","¿Estudias en casa?","Do you study at home?"],["Friend","Sí, estudio en casa.","Yes, I study at home."]]},"descriptions":{"kind":"spanish","lines":[["You","Soy estudiante. Estoy en casa.","I’m a student. I’m at home."],["You","Estoy aburrido.","I’m bored."],["Contrast","Soy aburrido.","I’m boring."]]},"cafe-project":{"kind":"spanish","lines":[["You","Hola. Quiero un café, por favor.","Hello. I want a coffee, please."],["Café worker","¿Para aquí o para llevar?","For here or to go?"],["You","¿Puede repetirlo más despacio, por favor?","Can you repeat it more slowly, please?"],["Café worker","¿Para aquí o para llevar?","For here or to go?"],["You","Para llevar, por favor. ¿Puedo pagar con tarjeta?","To go, please. Can I pay by card?"],["Café worker","Sí, con tarjeta. ¿Algo más?","Yes, by card. Anything else?"],["You","Nada más, gracias.","Nothing else, thank you."]]},"noun-phrases":{"kind":"spanish","lines":[["You","Quiero un café pequeño, por favor.","I want a small coffee, please."],["You, changing the order","Quiero dos cafés pequeños, por favor.","I want two small coffees, please."],["You","¿Hay una mesa pequeña?","Is there a small table?"],["Café worker","Sí, junto a la ventana.","Yes, next to the window."]]},"question-words":{"kind":"spanish","lines":[["Friend","Nos vemos mañana.","See you tom